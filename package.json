{
  "name": "koa",
  "version": "3.0.0",
  "description": "Koa web app framework",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/koa.mjs",
      "default": "./dist/koa.mjs"
    },
    "./*": "./*.js",
    "./*.js": "./*.js",
    "./package": "./package.json",
    "./package.json": "./package.json"
  },
  "_moduleAliases": {
    "~": "src"
  },
  "scripts": {
    "test": "find src -name \"*.test.ts\" | xargs ts-node",
    "test:source": "node --test",
    "test:ts": "find src -name \"*.test.ts\" | xargs ts-node",
    "test:compiled": "npm run build && node --test",
    "test:coverage": "npm run build && c8 --reporter=lcov --reporter=text-summary node --test",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "authors": "git log --format='%aN <%aE>' | sort -u > AUTHORS",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:esm": "echo 'import mod from \"./cjs/index.js\"; export default mod; export const HttpError = mod.HttpError;' > ./dist/koa.mjs",
    "build:types": "tsc",
    "build:cjs": "tsc -p tsconfig.json",
    "build:esm:ts": "tsc -p tsconfig.esm.json",
    "prepare": "npm run build",
    "ts:progress": "node scripts/typescript-progress.js"
  },
  "repository": "koajs/koa",
  "keywords": [
    "web",
    "app",
    "http",
    "application",
    "framework",
    "middleware",
    "rack"
  ],
  "license": "MIT",
  "dependencies": {
    "accepts": "^1.3.5",
    "cache-content-type": "^1.0.0",
    "content-disposition": "~0.5.2",
    "content-type": "^1.0.4",
    "cookies": "~0.9.1",
    "debug": "^4.3.2",
    "delegates": "^1.0.0",
    "destroy": "^1.0.4",
    "encodeurl": "^2.0.0",
    "escape-html": "^1.0.3",
    "fresh": "~0.5.2",
    "http-assert": "^1.3.0",
    "http-errors": "^2.0.0",
    "koa-compose": "^4.1.0",
    "module-alias": "^2.2.3",
    "on-finished": "^2.3.0",
    "parseurl": "^1.3.2",
    "statuses": "^2.0.1",
    "type-is": "^2.0.1",
    "vary": "^1.1.2"
  },
  "devDependencies": {
    "@types/accepts": "^1.3.7",
    "@types/content-disposition": "^0.5.8",
    "@types/content-type": "^1.1.8",
    "@types/cookies": "^0.9.0",
    "@types/debug": "^4.1.12",
    "@types/delegates": "^1.0.3",
    "@types/destroy": "^1.0.3",
    "@types/encodeurl": "^1.0.2",
    "@types/escape-html": "^1.0.4",
    "@types/fresh": "^0.5.2",
    "@types/http-assert": "^1.5.6",
    "@types/http-errors": "^2.0.4",
    "@types/koa-compose": "^3.2.8",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^20.11.4",
    "@types/on-finished": "^2.3.4",
    "@types/parseurl": "^1.3.3",
    "@types/statuses": "^2.0.5",
    "@types/supertest": "^6.0.3",
    "@types/type-is": "^1.6.7",
    "@types/vary": "^1.1.3",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "c8": "^10.1.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.4.0",
    "gen-esm-wrapper": "^1.0.6",
    "prettier": "^3.5.3",
    "snazzy": "^9.0.0",
    "standard": "^17.1.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">= 18"
  },
  "files": [
    "dist",
    "src"
  ],
  "homepage": "https://koajs.com"
}
